<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="nadir_world_obstacle">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"></plugin>

    <scene>
      <ambient>0.8 0.8 0.8</ambient>
      <background>0.5 0.7 0.9</background>
      <sky></sky>
    </scene>

    <model name="road">
      <static>true</static>
      <pose>0 25 0.005 0 0 1.570796</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>100 8 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <!-- Center line -->
        <visual name="line">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <box><size>100 0.2 0.01</size></box>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 0.9 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.6 0.4 1</ambient>
            <diffuse>0.4 0.6 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Landing Pad at (0, 40) -->
    <model name="landing_pad">
      <static>true</static>
      <pose>0 40 0.01 0 0 1.570796</pose>
      <link name="pad_link">
        <visual name="pad_base">
          <geometry>
            <box><size>3 3 0.01</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <visual name="pad_center">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <box><size>2 2 0.01</size></box>
          </geometry>
          <material>
            <pbr>
              <metal>
                <albedo_map>aruco_marker.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

    <!-- Obstacle: Vehicle parked directly overlapping the landing pad at (0.3, 40) -->
    <include>
      <name>hatchback_obstacle_on_pad</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <pose>0.3 40 0 0 0 1.5707</pose>
    </include>

    <!-- Distant background vehicle -->
    <include>
      <name>hatchback_distant</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <pose>2 60 0 0 0 4.71</pose>
    </include>

  </world>
</sdf>
